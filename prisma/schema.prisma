generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ====================
// کاربران و واحدها
// ====================

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  users     User[]
  requests  Request[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  username     String     @unique
  passwordHash String
  role         String     // ADMIN | SUPERVISOR | EMPLOYEE | WAREHOUSE
  active       Boolean    @default(true)

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  requests         Request[]           @relation("RequesterRequests")
  approvedRequests Request[]           @relation("ApproverRequests")
  goodsReceipts    GoodsReceipt[]
  warehouseIssues  WarehouseIssue[]
  transactions     InventoryTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ====================
// دسته‌بندی و کالا
// ====================

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  name        String
  unit        String    // عدد، کیلوگرم، متر، لیتر و...
  minStock    Float     @default(0)
  maxStock    Float?
  active      Boolean   @default(true)

  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id])

  requestItems      RequestItem[]
  receiptItems      GoodsReceiptItem[]
  issueItems        WarehouseIssueItem[]
  inventories       Inventory[]
  transactions      InventoryTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ====================
// انبار
// ====================

model Warehouse {
  id        Int       @id @default(autoincrement())
  name      String
  location  String?
  active    Boolean   @default(true)

  inventories  Inventory[]
  receipts     GoodsReceipt[]
  issues       WarehouseIssue[]
  transactions InventoryTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ====================
// موجودی فعلی
// ====================

model Inventory {
  id          Int       @id @default(autoincrement())

  productId   Int
  warehouseId Int

  quantity    Float     @default(0)

  product     Product   @relation(fields: [productId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([productId, warehouseId])
}

// ====================
// درخواست کالا
// ====================

model Request {
  id            Int      @id @default(autoincrement())

  requestNumber String   @unique

  requesterId   Int
  departmentId  Int

  status        String   @default("PENDING")
  description   String?

  approvedById  Int?
  approvedAt    DateTime?
  rejectedReason String?

  requester     User       @relation("RequesterRequests", fields: [requesterId], references: [id])
  approvedBy    User?      @relation("ApproverRequests", fields: [approvedById], references: [id])
  department    Department @relation(fields: [departmentId], references: [id])

  items          RequestItem[]
  warehouseIssue WarehouseIssue?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ====================
// اقلام درخواست
// ====================

model RequestItem {
  id        Int @id @default(autoincrement())

  requestId Int
  productId Int

  requestedQuantity Float
  approvedQuantity  Float?
  deliveredQuantity Float @default(0)

  request  Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product  Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
}

// ====================
// قبض انبار
// ====================

model GoodsReceipt {
  id            Int      @id @default(autoincrement())

  receiptNumber String   @unique

  warehouseId   Int
  receivedById  Int

  supplier      String?
  purchaseNumber String?

  status        String   @default("DRAFT")
  description   String?

  receiptDate DateTime  @default(now())

  warehouse  Warehouse @relation(fields: [warehouseId], references: [id])
  receivedBy User       @relation(fields: [receivedById], references: [id])

  items GoodsReceiptItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ====================
// اقلام قبض انبار
// ====================

model GoodsReceiptItem {
  id        Int @id @default(autoincrement())

  receiptId Int
  productId Int

  receivedQuantity Float
  acceptedQuantity Float
  rejectedQuantity Float @default(0)

  qualityStatus String @default("ACCEPTED")
  description   String?

  receipt  GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product  Product      @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
}

// ====================
// حواله انبار
// ====================

model WarehouseIssue {
  id          Int      @id @default(autoincrement())

  issueNumber String   @unique

  requestId   Int       @unique
  warehouseId Int
  issuedById  Int

  status      String   @default("DRAFT")
  description String?

  issueDate DateTime @default(now())

  request   Request   @relation(fields: [requestId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  issuedBy  User      @relation(fields: [issuedById], references: [id])

  items WarehouseIssueItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ====================
// اقلام حواله
// ====================

model WarehouseIssueItem {
  id       Int @id @default(autoincrement())

  issueId   Int
  productId Int

  quantity Float

  issue    WarehouseIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  product  Product        @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
}

// ====================
// گردش موجودی
// ====================

model InventoryTransaction {
  id          Int      @id @default(autoincrement())

  productId   Int
  warehouseId Int
  createdById Int

  type        String   // IN | OUT
  quantity    Float

  referenceType String? // GOODS_RECEIPT | WAREHOUSE_ISSUE
  referenceId   Int?

  description String?

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
}